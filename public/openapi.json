{
  "openapi": "3.0.0",
  "info": {
    "title": "Cards Against Singularity API",
    "description": "API for minting AI-themed NFT cards. Uses x402 protocol for payment (0.01 USDC on Base Sepolia).",
    "version": "1.0.0",
    "contact": {
      "name": "Cards Against Singularity",
      "url": "https://cards-against-singulaity.vercel.app"
    }
  },
  "servers": [
    {
      "url": "https://cards-against-singulaity.vercel.app",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/cards": {
      "get": {
        "operationId": "getCards",
        "summary": "Get available cards",
        "description": "Returns all available prompt (black) and answer (white) cards that can be used when minting NFTs.",
        "responses": {
          "200": {
            "description": "List of available cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardsResponse"
                },
                "example": {
                  "prompts": [
                    { "index": 0, "content": "Every AI Agent Deserves _____.", "isBlack": true }
                  ],
                  "answers": [
                    { "index": 0, "content": "A wallet", "isBlack": false }
                  ],
                  "totalPrompts": 35,
                  "totalAnswers": 70
                }
              }
            }
          }
        }
      }
    },
    "/api/agent-mint": {
      "post": {
        "operationId": "mintNFT",
        "summary": "Mint NFT with selected cards",
        "description": "Mint an NFT with selected cards. Protected by x402 protocol - requires 0.01 USDC payment on Base Sepolia. First request returns 402 Payment Required with payment details. Sign the payment and retry with X-PAYMENT header.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MintRequest"
              },
              "example": {
                "walletAddress": "0x1234567890abcdef1234567890abcdef12345678",
                "promptIndices": [0],
                "answerIndices": [0, 5]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "NFT minted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MintResponse"
                }
              }
            }
          },
          "402": {
            "description": "Payment required. Response includes x402 payment requirements in PAYMENT-REQUIRED header.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 payment requirements",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequiredResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (missing wallet address, invalid card indices)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Card index for selection"
          },
          "content": {
            "type": "string",
            "description": "Card text content"
          },
          "isBlack": {
            "type": "boolean",
            "description": "true for prompt cards (black), false for answer cards (white)"
          }
        },
        "required": ["index", "content", "isBlack"]
      },
      "CardsResponse": {
        "type": "object",
        "properties": {
          "prompts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "description": "Black prompt cards with blanks to fill"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "description": "White answer cards"
          },
          "totalPrompts": {
            "type": "integer",
            "description": "Total number of prompt cards"
          },
          "totalAnswers": {
            "type": "integer",
            "description": "Total number of answer cards"
          }
        },
        "required": ["prompts", "answers", "totalPrompts", "totalAnswers"]
      },
      "CustomCard": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Custom card text"
          },
          "isBlack": {
            "type": "boolean",
            "description": "true for prompt (black), false for answer (white)"
          }
        },
        "required": ["content", "isBlack"]
      },
      "MintRequest": {
        "type": "object",
        "properties": {
          "walletAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "Ethereum address to receive the NFT"
          },
          "promptIndices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 34
            },
            "description": "Indices of prompt cards to include (0-34)"
          },
          "answerIndices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 69
            },
            "description": "Indices of answer cards to include (0-69)"
          },
          "customCards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomCard"
            },
            "description": "Optional custom cards to include"
          }
        },
        "required": ["walletAddress"]
      },
      "MintResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "transactionHash": {
            "type": "string",
            "description": "Blockchain transaction hash"
          },
          "transactionLink": {
            "type": "string",
            "format": "uri",
            "description": "Link to view transaction on block explorer"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the minted NFT image"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomCard"
            },
            "description": "Cards included in the NFT"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["success", "transactionHash", "transactionLink", "imageUrl", "cards", "message"]
      },
      "PaymentRequiredResponse": {
        "type": "object",
        "properties": {
          "x402Version": {
            "type": "integer",
            "enum": [2]
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "enum": ["exact"]
                },
                "network": {
                  "type": "string",
                  "example": "eip155:84532"
                },
                "amount": {
                  "type": "string",
                  "example": "10000",
                  "description": "Amount in atomic units (10000 = 0.01 USDC)"
                },
                "asset": {
                  "type": "string",
                  "example": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
                  "description": "USDC token address on Base Sepolia"
                },
                "payTo": {
                  "type": "string",
                  "description": "Address to receive payment"
                },
                "extra": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      }
    }
  }
}
